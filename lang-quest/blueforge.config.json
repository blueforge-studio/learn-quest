{
  "project": "lang-quest",
  "assets": {
    "primary": { "provider": "minio", "bucket": "nordic-quest-assets" },
    "mirrors": [ { "provider": "cloudflare_r2", "bucket": "nordic-quest-assets" } ],
    "push": [
      { "source": "public/_shared/images", "prefix": "shared/images" },
      { "source": "public/_regional/universal", "prefix": "regional/universal" },
      { "source": "public/data", "prefix": "data" },
      { "source": "public/languages", "prefix": "languages", "filter": "images,audio" }
    ],
    "pull": [ { "prefix": "data", "dest": "/usr/share/nginx/html/data" } ]
  },
