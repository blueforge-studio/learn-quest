{
  "project": "lang-quest",
  "assets": {
    "primary": {
      "provider": "cloudflare_r2",
      "bucket": "lq-assets"
    },
    "mirrors": [
      {
        "provider": "minio",
        "bucket": "<group>-quest-assets"
      }
    ],
    "push": [
      {
        "source": "public/_regional/universal",
        "prefix": "_regional/universal"
      },
      {
        "source": "public/_shared/images",
        "prefix": "<group>/_shared/images"
      },
      {
        "source": "public/languages",
        "prefix": "apps/<group>",
        "filter": "images,audio"
      }
    ],
    "pull": []
  },
  "apps": {
    "lq-nordic": {
      "name": "nordic-quest",
      "bucket": "nordic-quest-assets",
      "domains": [
        "nordic-quest.blueforge.studio"
      ],
      "infra": {
        "s3Host": null,
        "r2": {
          "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
          "bucket": "lq-assets"
        }
      },
      "ignore": [
        "scripts/audit-*",
        "tests/**/*.spec.ts",
        "test-results",
        "playwright-report",
        "screen-audit",
        "audit-results",
        ".playwright-mcp",
        "*.log",
        "lq.config.json",
        "asset-map.json",
        "package-lock.json",
        "public/_shared/images",
        "public/_regional",
        "public/languages",
        "public/data"
      ]
    },
    "lq-african": {
