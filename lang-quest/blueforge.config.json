      "ignore": ["scripts/audit-*", "tests/**/*.spec.ts", "test-results", "playwright-report", "screen-audit", "audit-results", ".playwright-mcp", "*.log", "lq.config.json", "asset-map.json", "package-lock.json", "public/_shared/images", "public/_regional", "public/languages", "public/data"]
